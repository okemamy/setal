          "stringUnit": {
            "state": "translated",
            "value": "Il prossimo «go build» riscarica i moduli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次回の「go build」でモジュールが再ダウンロードされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 “go build” 시 모듈을 다시 다운로드합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De volgende ‘go build’ downloadt de modules opnieuw."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O próximo “go build” baixa os módulos de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Следующий «go build» снова загрузит модули."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir sonraki “go build” modülleri yeniden indirir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下次“go build”会重新下载模块。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下次「go build」會重新下載模組。"
          }
        }
      }
    },
    "Le swap et les fichiers temporaires du système ne disparaissent qu'au redémarrage du Mac.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تختفي ملفات التبديل والملفات المؤقتة للنظام إلا عند إعادة تشغيل Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Swap und temporäre Systemdateien verschwinden erst beim Neustart des Mac."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swap and system temporary files only go away when you restart the Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El swap y los archivos temporales del sistema solo desaparecen al reiniciar el Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo swap e i file temporanei di sistema spariscono solo al riavvio del Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スワップとシステムの一時ファイルは、Mac を再起動したときにのみ消去されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스왑 및 시스템 임시 파일은 Mac을 재시동해야만 사라집니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Swap en tijdelijke systeembestanden verdwijnen pas bij een herstart van de Mac."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O swap e os arquivos temporários do sistema só somem ao reiniciar o Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл подкачки и временные файлы системы исчезают только после перезагрузки Mac."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Takas alanı ve sistemin geçici dosyaları yalnızca Mac yeniden başlatıldığında silinir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "交换文件和系统临时文件只有在重新启动 Mac 后才会消失。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "交換檔和系統暫存檔只有在重新啟動 Mac 後才會消失。"
          }
        }
      }
    },
    "Les anciens journaux de diagnostic disparaissent.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحذف سجلات التشخيص القديمة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alte Diagnoseprotokolle werden entfernt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Old diagnostic logs are removed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los registros de diagnóstico antiguos desaparecen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I vecchi log di diagnostica vengono rimossi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "古い診断ログが削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 진단 로그가 제거됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oude diagnoselogbestanden worden verwijderd."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os logs de diagnóstico antigos são removidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Старые журналы диагностики удаляются."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eski tanılama günlükleri silinir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "旧的诊断日志将被移除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "舊的診斷記錄將被移除。"
          }
        }
