            "state": "translated",
            "value": "A primeira pré-visualização será mais lenta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Первое превью будет медленнее."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlk önizleme daha yavaş olacak."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "首次预览会较慢。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "首次預覽會較慢。"
          }
        }
      }
    },
    "Le premier build Android ou Flutter retélécharge les dépendances.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيعيد أول بناء لـ Android أو Flutter تنزيل التبعيات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der erste Android- oder Flutter-Build lädt die Abhängigkeiten erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first Android or Flutter build downloads dependencies again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La primera compilación Android o Flutter vuelve a descargar las dependencias."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La prima build Android o Flutter riscarica le dipendenze."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初の Android または Flutter のビルドで依存関係が再ダウンロードされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫 Android 또는 Flutter 빌드 시 종속성을 다시 다운로드합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De eerste Android- of Flutter-build downloadt de afhankelijkheden opnieuw."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O primeiro build Android ou Flutter baixa as dependências de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Первая сборка Android или Flutter снова загрузит зависимости."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlk Android veya Flutter derlemesi bağımlılıkları yeniden indirir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
