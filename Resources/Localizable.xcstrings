          "stringUnit": {
            "state": "translated",
            "value": "元に戻せません：ゴミ箱内のファイルは復元できなくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영구 삭제: 휴지통의 파일은 더 이상 복구할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Definitief: bestanden in de prullenmand kunnen niet meer worden teruggezet."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Definitivo: os arquivos do Lixo não poderão mais ser recuperados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Безвозвратно: файлы из Корзины больше нельзя будет восстановить."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalıcı: Çöp Sepeti'ndeki dosyalar artık kurtarılamaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "永久性：废纸篓中的文件将无法恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "永久性：垃圾桶中的檔案將無法復原。"
          }
        }
      }
    },
