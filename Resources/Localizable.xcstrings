    "Sauvegardes locales faites par le Finder. Souvent des dizaines de Go.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نسخ احتياطية محلية أنشأها Finder. غالبًا عشرات الغيغابايت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale Backups des Finder. Oft Dutzende GB."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local backups made by Finder. Often tens of GB."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copias locales hechas por el Finder. A menudo decenas de GB."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup locali creati dal Finder. Spesso decine di GB."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder で作成したローカルバックアップ。数十 GB になることもよくあります。"
