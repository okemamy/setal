    "Une copie complète de Gradle par version utilisée dans tes projets.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نسخة كاملة من Gradle لكل إصدار تستخدمه مشاريعك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine vollständige Gradle-Kopie pro Version, die deine Projekte verwenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A full copy of Gradle for each version your projects use."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una copia completa de Gradle por cada versión usada en tus proyectos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una copia completa di Gradle per ogni versione usata nei tuoi progetti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロジェクトで使用している Gradle のバージョンごとの完全なコピー。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로젝트에서 사용하는 Gradle 버전별 전체 사본."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een volledige kopie van Gradle voor elke versie die je projecten gebruiken."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma cópia completa do Gradle para cada versão usada nos seus projetos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полная копия Gradle для каждой версии, используемой в ваших проектах."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Projelerinizde kullanılan her sürüm için Gradle'ın tam bir kopyası."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的项目所用每个 Gradle 版本的完整副本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的專案所用每個 Gradle 版本的完整副本。"
          }
        }
      }
    },
    "Versions d'iOS remplacées par une plus récente ou marquées inutilisables. Plusieurs Go chacune, stockées hors de ton dossier personnel.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إصدارات iOS حلّ محلها إصدار أحدث أو تم وضع علامة عليها كغير قابلة للاستخدام. يبلغ حجم كل منها عدة غيغابايت، وهي مخزنة خارج مجلد الحساب الرئيسي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS-Versionen, die durch eine neuere ersetzt oder als unbrauchbar markiert wurden. Jeweils mehrere GB, außerhalb deines Benutzerordners gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS versions replaced by a newer one or marked unusable. Several GB each, stored outside your home folder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Versiones de iOS reemplazadas por una más reciente o marcadas como inutilizables. Varios GB cada una, fuera de tu carpeta personal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Versioni di iOS sostituite da una più recente o contrassegnate come inutilizzabili. Diversi GB ciascuna, archiviate fuori dalla tua cartella Inizio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいバージョンに置き換えられたか、使用不可とマークされた iOS バージョン。それぞれ数 GB あり、ホームフォルダの外に保存されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최신 버전으로 대체되었거나 사용할 수 없음으로 표시된 iOS 버전. 각각 수 GB이며 홈 폴더 외부에 저장됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS-versies die door een nieuwere zijn vervangen of als onbruikbaar zijn gemarkeerd. Elk meerdere GB, opgeslagen buiten je thuismap."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Versões do iOS substituídas por uma mais recente ou marcadas como inutilizáveis. Vários GB cada, fora da sua pasta pessoal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Версии iOS, замененные более новыми или помеченные как непригодные. По несколько ГБ каждая, хранятся вне вашей домашней папки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha yeni bir sürümle değiştirilmiş veya kullanılamaz olarak işaretlenmiş iOS sürümleri. Her biri birkaç GB'tır ve ana klasörünüzün dışında saklanır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已被新版本取代或标记为不可用的 iOS 版本。每个数 GB，存储在个人文件夹之外。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已被新版本取代或標示為無法使用的 iOS 版本。每個數 GB，儲存在個人專屬檔案夾之外。"
          }
        }
      }
    },
