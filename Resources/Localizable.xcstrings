    },
    "Les appareils restent, mais il faudra réinstaller les apps dessus.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى الأجهزة، لكن سيلزم إعادة تثبيت التطبيقات عليها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Geräte bleiben, aber du musst die Apps darauf neu installieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Devices stay, but you will need to reinstall apps on them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los dispositivos se conservan, pero habrá que reinstalar las apps."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dispositivi restano, ma dovrai reinstallarci le app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスは残りますが、App を再インストールする必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기는 유지되지만 앱을 다시 설치해야 합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De apparaten blijven, maar je moet de apps erop opnieuw installeren."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dispositivos ficam, mas será preciso reinstalar os apps neles."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устройства останутся, но приложения на них придется установить заново."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aygıtlar kalır ancak üzerlerindeki uygulamaları yeniden yüklemeniz gerekir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备会保留，但需要在其上重新安装 App。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "裝置會保留，但需要在上面重新安裝 App。"
          }
        }
      }
    },
    "Les apps reconstruisent leurs caches au besoin.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعيد التطبيقات إنشاء ذاكرات التخزين المؤقت عند الحاجة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps bauen ihre Caches bei Bedarf neu auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps rebuild their caches as needed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las apps reconstruyen sus cachés cuando lo necesitan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le app ricostruiscono le cache quando serve."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App は必要に応じてキャッシュを再構築します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱은 필요에 따라 캐시를 다시 생성합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps bouwen hun caches zo nodig opnieuw op."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os apps recriam seus caches quando necessário."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложения пересоздают кэши по мере необходимости."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamalar önbelleklerini gerektiğinde yeniden oluşturur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App 会根据需要重建缓存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 會視需要重建快取。"
          }
        }
      }
    },
    "Les données des bases locales qu'ils contiennent sont perdues.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُفقد بيانات قواعد البيانات المحلية المخزنة فيها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Darin gespeicherte Daten lokaler Datenbanken gehen verloren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local database data stored in them is lost."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se pierden los datos de las bases locales que contienen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dati dei database locali che contengono vanno persi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらに含まれるローカルデータベースのデータは失われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기에 저장된 로컬 데이터베이스 데이터가 손실됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Data van lokale databases die erin staan gaat verloren."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dados dos bancos locais que eles contêm são perdidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные локальных баз, хранящиеся в них, будут потеряны."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İçerdikleri yerel veritabanı verileri kaybolur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其中存储的本地数据库数据将丢失。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "其中儲存的本機資料庫資料將遺失。"
          }
        }
      }
    },
    "Les environnements se recréent en retéléchargeant.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُعاد إنشاء البيئات بإعادة التنزيل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Umgebungen werden durch erneutes Laden neu erstellt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Environments are recreated by downloading again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los entornos se recrean volviendo a descargar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli ambienti si ricreano riscaricando."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "環境は再ダウンロードによって再作成されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "환경은 다시 다운로드하여 재생성됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Omgevingen worden opnieuw aangemaakt door opnieuw te downloaden."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os ambientes são recriados baixando de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Окружения воссоздаются повторной загрузкой."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ortamlar yeniden indirilerek yeniden oluşturulur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "环境会通过重新下载重建。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "環境會透過重新下載重建。"
          }
        }
      }
    },
    "Les prochains « bun install » retéléchargent.": {
