    "Mis à la Corbeille : %@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نُقل إلى سلة المهملات: %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In den Papierkorb gelegt: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moved to Trash: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Movido a la Papelera: %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spostato nel Cestino: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゴミ箱に入れました：%@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통으로 이동됨: %@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naar prullenmand verplaatst: %@"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Movido para o Lixo: %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перемещено в Корзину: %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çöp Sepeti'ne taşındı: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已移到废纸篓：%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已丟到垃圾桶：%@"
          }
        }
      }
    },
    "Mis à la Corbeille, donc récupérables. Un Xcode.xip pèse à lui seul plus de 10 Go.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُنقل إلى سلة المهملات، لذا يمكن استردادها. يتجاوز حجم ملف Xcode.xip وحده 10 غيغابايت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In den Papierkorb gelegt, also wiederherstellbar. Eine einzige Xcode.xip ist über 10 GB groß."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moved to the Trash, so recoverable. A single Xcode.xip weighs more than 10 GB."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se mueven a la Papelera, así que se pueden recuperar. Un solo Xcode.xip pesa más de 10 GB."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spostati nel Cestino, quindi recuperabili. Un solo Xcode.xip pesa più di 10 GB."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゴミ箱に入れるので復元できます。Xcode.xip だけで 10 GB を超えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통으로 이동되므로 복구할 수 있습니다. Xcode.xip 하나만 해도 10GB가 넘습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naar de prullenmand verplaatst, dus terug te zetten. Eén Xcode.xip is alleen al groter dan 10 GB."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Movidos para o Lixo, portanto recuperáveis. Um único Xcode.xip pesa mais de 10 GB."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перемещаются в Корзину, поэтому их можно восстановить. Один только Xcode.xip весит больше 10 ГБ."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çöp Sepeti'ne taşınır, bu yüzden kurtarılabilir. Tek bir Xcode.xip bile 10 GB'tan büyüktür."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移到废纸篓，因此可以恢复。单个 Xcode.xip 就超过 10 GB。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "丟到垃圾桶，因此可以復原。單一個 Xcode.xip 就超過 10 GB。"
          }
        }
      }
    },
    "Mises à jour iOS téléchargées": {
      "localizations": {
