    "Xcode les retélécharge (Réglages › Components) si un projet en a besoin.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعيد Xcode تنزيلها (Settings › Components) إذا احتاجها أحد المشاريع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode lädt sie erneut (Einstellungen › Components), wenn ein Projekt sie braucht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode downloads them again (Settings › Components) if a project needs them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode las vuelve a descargar (Ajustes › Components) si un proyecto las necesita."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode li riscarica (Impostazioni › Components) se un progetto ne ha bisogno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロジェクトで必要になれば、Xcode が再ダウンロードします（Settings › Components）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로젝트에 필요하면 Xcode가 다시 다운로드합니다(Settings › Components)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode downloadt ze opnieuw (Instellingen › Components) als een project ze nodig heeft."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Xcode baixa de novo (Ajustes › Components) se um projeto precisar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode загрузит их снова (Settings › Components), если они понадобятся проекту."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir proje ihtiyaç duyarsa Xcode bunları yeniden indirir (Settings › Components)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果项目需要，Xcode 会重新下载（Settings › Components）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果專案需要，Xcode 會重新下載（Settings › Components）。"
          }
        }
      }
    },
