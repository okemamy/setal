    },
    "Sans les dSYM, les crashs des versions publiées ne sont plus symbolisables.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بدون ملفات dSYM، لا يمكن بعد ذلك ترميز أعطال الإصدارات المنشورة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne dSYMs lassen sich Abstürze veröffentlichter Versionen nicht mehr symbolisieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without dSYMs, crashes from released versions can no longer be symbolicated."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin los dSYM, los fallos de las versiones publicadas ya no se pueden simbolizar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza i dSYM, i crash delle versioni pubblicate non possono più essere simbolizzati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "dSYM がないと、リリース済みバージョンのクラッシュをシンボル化できなくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "dSYM이 없으면 출시된 버전의 충돌을 더 이상 기호화할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zonder dSYM's zijn crashes van gepubliceerde versies niet meer te symboliseren."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem os dSYMs, os crashes das versões publicadas não podem mais ser simbolizados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без dSYM сбои опубликованных версий больше нельзя символизировать."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "dSYM dosyaları olmadan yayımlanmış sürümlerin çökmeleri artık sembolize edilemez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有 dSYM，已发布版本的崩溃将无法再符号化。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有 dSYM，已發佈版本的當機將無法再符號化。"
          }
        }
      }
    },
