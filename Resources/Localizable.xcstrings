    "Copies que macOS garde sur le disque interne entre deux sauvegardes.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نُسخ يحتفظ بها macOS على القرص الداخلي بين عمليتي نسخ احتياطي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopien, die macOS zwischen zwei Backups auf dem internen Volume behält."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copies macOS keeps on the internal disk between backups."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copias que macOS guarda en el disco interno entre copias de seguridad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Copie che macOS conserva sul disco interno tra un backup e l’altro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次のバックアップまで macOS が内蔵ディスクに保持するコピー。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS가 백업 사이에 내장 디스크에 보관하는 사본."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopieën die macOS tussen twee reservekopieën op de interne schijf bewaart."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cópias que o macOS mantém no disco interno entre backups."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Копии, которые macOS хранит на внутреннем диске между резервными копированиями."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS'in iki yedekleme arasında dahili diskte tuttuğu kopyalar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 在两次备份之间保留在内置磁盘上的副本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 在兩次備份之間保留在內建磁碟上的副本。"
          }
        }
      }
    },
    "Copiés depuis chaque iPhone, iPad ou Apple Watch branché pour le débogage : plusieurs Go par version d'iOS.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُنسخ من كل iPhone أو iPad أو Apple Watch يتم توصيله لتصحيح الأخطاء: عدة غيغابايت لكل إصدار من iOS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von jedem zum Debuggen verbundenen iPhone, iPad oder jeder Apple Watch kopiert: mehrere GB pro iOS-Version."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copied from every iPhone, iPad or Apple Watch connected for debugging: several GB per iOS version."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiados de cada iPhone, iPad o Apple Watch conectado para depurar: varios GB por versión de iOS."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiati da ogni iPhone, iPad o Apple Watch collegato per il debug: diversi GB per versione di iOS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバッグ用に接続した各 iPhone、iPad、Apple Watch からコピーされたもの：iOS のバージョンごとに数 GB。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디버깅을 위해 연결한 각 iPhone, iPad 또는 Apple Watch에서 복사됨: iOS 버전당 수 GB."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gekopieerd van elke iPhone, iPad of Apple Watch die voor debuggen is aangesloten: meerdere GB per iOS-versie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiados de cada iPhone, iPad ou Apple Watch conectado para depuração: vários GB por versão do iOS."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Копируются с каждого iPhone, iPad или Apple Watch, подключенного для отладки: несколько ГБ на каждую версию iOS."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hata ayıklama için bağlanan her iPhone, iPad veya Apple Watch'tan kopyalanır: iOS sürümü başına birkaç GB."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从每台为调试而连接的 iPhone、iPad 或 Apple Watch 拷贝而来：每个 iOS 版本数 GB。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從每部為除錯而連接的 iPhone、iPad 或 Apple Watch 拷貝而來：每個 iOS 版本數 GB。"
          }
        }
      }
    },
