    "La version actuelle a déjà importé ses réglages ; seules les anciennes disparaissent.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استوردت النسخة الحالية إعداداتها بالفعل؛ تُحذف الإصدارات القديمة فقط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die aktuelle Version hat ihre Einstellungen bereits übernommen; nur alte Versionen werden entfernt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current version has already imported its settings; only old versions are removed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La versión actual ya importó sus ajustes; solo desaparecen las antiguas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La versione attuale ha già importato le sue impostazioni; vengono rimosse solo quelle vecchie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のバージョンは設定をすでに読み込み済みです。削除されるのは古いバージョンのみです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 버전은 이미 설정을 가져왔으며, 이전 버전만 제거됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De huidige versie heeft haar instellingen al overgenomen; alleen oude versies worden verwijderd."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A versão atual já importou seus ajustes; só as antigas são removidas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текущая версия уже импортировала свои настройки; удаляются только старые."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçerli sürüm ayarlarını zaten içe aktardı; yalnızca eski sürümler silinir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前版本已导入其设置；只会移除旧版本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前版本已匯入其設定；只會移除舊版本。"
          }
        }
      }
    },
