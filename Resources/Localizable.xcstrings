    "Chaque outil retélécharge ce dont il a besoin, parfois plusieurs Go (modèles d'IA).": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعيد كل أداة تنزيل ما تحتاجه، وأحيانًا عدة غيغابايت (نماذج الذكاء الاصطناعي)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Tool lädt erneut, was es braucht – manchmal mehrere GB (KI-Modelle)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each tool downloads what it needs again, sometimes several GB (AI models)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada herramienta vuelve a descargar lo que necesita, a veces varios GB (modelos de IA)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni strumento riscarica ciò che gli serve, a volte diversi GB (modelli di IA)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各ツールが必要なものを再ダウンロードします。数 GB になることもあります（AI モデル）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 도구가 필요한 항목을 다시 다운로드하며, 때로는 수 GB에 달합니다(AI 모델)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elk hulpmiddel downloadt opnieuw wat het nodig heeft, soms meerdere GB (AI-modellen)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada ferramenta baixa de novo o que precisa, às vezes vários GB (modelos de IA)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый инструмент снова загрузит нужное, иногда несколько ГБ (модели ИИ)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her araç ihtiyacı olanı yeniden indirir, bazen birkaç GB (yapay zekâ modelleri)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "各工具会重新下载所需内容，有时多达数 GB（AI 模型）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "各工具會重新下載所需內容，有時多達數 GB（AI 模型）。"
          }
        }
      }
    },
    "Chaque projet Flutter devra refaire « flutter pub get ».": {
      "localizations": {
