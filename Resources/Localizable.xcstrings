    "Ferme ces apps avant : elles reconstruisent leurs caches au prochain lancement.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنهِ هذه التطبيقات أولًا: ستعيد إنشاء ذاكرات التخزين المؤقت عند تشغيلها في المرة القادمة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beende diese Apps vorher: Sie bauen ihre Caches beim nächsten Start neu auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quit these apps first: they rebuild their caches on next launch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierra esas apps antes: reconstruyen sus cachés al volver a abrirlas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiudi prima queste app: ricostruiranno le cache al prossimo avvio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先にこれらの App を終了してください。次回起動時にキャッシュが再構築されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 이 앱들을 종료하십시오. 다음 실행 시 캐시가 다시 생성됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop deze apps eerst: ze bouwen hun caches opnieuw op bij de volgende start."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Feche esses apps antes: eles recriam seus caches na próxima abertura."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала закройте эти приложения: они пересоздадут кэши при следующем запуске."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce bu uygulamalardan çıkın: bir sonraki açılışta önbelleklerini yeniden oluştururlar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先退出这些 App：它们会在下次启动时重建缓存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先結束這些 App：它們會在下次啟動時重建快取。"
          }
        }
      }
    },
