            "state": "translated",
            "value": "Systemeinstellungen › Speicher kann einige Minuten brauchen, um den neuen Wert anzuzeigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings › Storage may take a few minutes to show the new figure."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustes › Almacenamiento puede tardar unos minutos en mostrar la nueva cifra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impostazioni di Sistema › Spazio di archiviazione può impiegare qualche minuto per mostrare il nuovo valore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「システム設定」›「ストレージ」に新しい値が表示されるまで数分かかることがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정 › 저장 공간에 새 수치가 표시되기까지 몇 분 정도 걸릴 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het kan enkele minuten duren voordat Systeeminstellingen › Opslag het nieuwe getal toont."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustes › Armazenamento pode levar alguns minutos para mostrar o novo valor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В «Системных настройках» › «Хранилище» новое значение может появиться через несколько минут."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem Ayarları › Depolama'nın yeni değeri göstermesi birkaç dakika sürebilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“系统设置”›“储存空间”可能需要几分钟才能显示新数值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「系統設定」›「儲存空間」可能需要幾分鐘才會顯示新數值。"
          }
        }
      }
    },
    "Réglages, plugins et index JetBrains et Android Studio de versions remplacées par une plus récente.": {
      "localizations": {
        "ar": {
