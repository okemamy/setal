    "Le SDK Manager les retélécharge à la création d'un émulateur.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعيد SDK Manager تنزيلها عند إنشاء محاكٍ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der SDK Manager lädt sie beim Erstellen eines Emulators erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The SDK Manager downloads them again when you create an emulator."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El SDK Manager las vuelve a descargar al crear un emulador."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’SDK Manager le riscarica quando crei un emulatore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エミュレータを作成するときに SDK Manager が再ダウンロードします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에뮬레이터를 만들 때 SDK Manager가 다시 다운로드합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De SDK Manager downloadt ze opnieuw wanneer je een emulator aanmaakt."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O SDK Manager baixa de novo ao criar um emulador."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "SDK Manager снова загрузит их при создании эмулятора."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "SDK Manager, bir emülatör oluşturduğunuzda bunları yeniden indirir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创建模拟器时 SDK Manager 会重新下载。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "建立模擬器時 SDK Manager 會重新下載。"
          }
        }
      }
    },
    "Le disque virtuel Docker.raw grossit sans jamais rendre l'espace tout seul.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستمر القرص الافتراضي Docker.raw في التضخم ولا يعيد المساحة من تلقاء نفسه أبدًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die virtuelle Festplatte Docker.raw wächst stetig und gibt Speicher nie von selbst frei."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Docker.raw virtual disk keeps growing and never gives space back on its own."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El disco virtual Docker.raw crece sin devolver nunca el espacio por sí solo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il disco virtuale Docker.raw continua a crescere e non restituisce mai spazio da solo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "仮想ディスク Docker.raw は大きくなり続け、空き領域を自動では返しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker.raw 가상 디스크는 계속 커지며 공간을 스스로 반환하지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De virtuele schijf Docker.raw blijft groeien en geeft nooit uit zichzelf ruimte terug."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O disco virtual Docker.raw cresce e nunca devolve o espaço sozinho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Виртуальный диск Docker.raw растет и никогда не освобождает место сам."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker.raw sanal diski büyümeye devam eder ve alanı asla kendiliğinden geri vermez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker.raw 虚拟磁盘会不断增大，且不会自行释放空间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker.raw 虛擬磁碟會不斷變大，且不會自行釋放空間。"
          }
        }
      }
    },
    "Le premier aperçu sera plus lent.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستكون المعاينة الأولى أبطأ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die erste Vorschau ist langsamer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first preview will be slower."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La primera vista previa será más lenta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La prima anteprima sarà più lenta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初のプレビューは遅くなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫 번째 미리보기가 느려집니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De eerste voorvertoning is trager."
          }
        },
        "pt": {
