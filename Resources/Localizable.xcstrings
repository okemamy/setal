    "%@ : %lld élément(s) supprimé(s), %lld protégé(s) par macOS laissé(s) en place": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: العناصر المحذوفة: %lld، والعناصر المحمية بواسطة macOS المتروكة في مكانها: %lld"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: %lld Objekt(e) gelöscht, %lld von macOS geschützte belassen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: %lld item(s) deleted, %lld protected by macOS left in place"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: %lld elemento(s) eliminado(s), %lld protegido(s) por macOS sin tocar"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: %lld elemento/i eliminato/i, %lld protetto/i da macOS lasciato/i al loro posto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：%lld 項目を削除、macOS で保護された %lld 項目はそのまま残しました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: %lld개 항목 삭제됨, macOS가 보호하는 %lld개 항목은 그대로 둠"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: %lld onderdeel/onderdelen verwijderd, %lld door macOS beschermd(e) laten staan"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: %lld item(ns) apagado(s), %lld protegido(s) pelo macOS mantido(s)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: удалено объектов: %lld, защищено macOS и оставлено на месте: %lld"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: %lld öğe silindi, macOS tarafından korunan %lld öğe yerinde bırakıldı"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：已删除 %lld 个项目，%lld 个受 macOS 保护的项目保持原样"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：已刪除 %lld 個項目，%lld 個受 macOS 保護的項目保持原樣"
          }
        }
      }
    },
